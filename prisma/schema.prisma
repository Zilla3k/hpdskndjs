generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  USER
}

model User {
  id            String @id @default(uuid()) @db.Uuid
  name          String 
  email         String @unique
  passwordHash  String
  role          Role @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}